# Copie este arquivo para .env e ajuste se necessario.
# O sistema funciona sem nenhuma configuracao: todos os valores tem padrao.

# Chave usada para assinar a sessao e o login.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
PRF_SECRET_KEY=troque-esta-chave-em-uso-real

# Senha de acesso, como HASH. Obrigatoria para publicar na internet.
# Gere com: python -m flask --app run:app set-password
# Vazio = modo local sem login (a aplicacao so responde em 127.0.0.1).
PRF_PASSWORD_HASH=

# Fuso horario. NAO deixe em branco ao hospedar: servidores rodam em UTC e as
# datas registradas a noite sairiam com o dia seguinte.
PRF_TIMEZONE=America/Sao_Paulo

# 1 quando o site for servido por HTTPS (hospedado). Marca o cookie como Secure.
PRF_HTTPS=0

# Caminho do banco SQLite (padrao: ./data/prf.db)
# PRF_DATABASE=C:/Users/ALAN/Documents/System-PRF/data/prf.db

# Host e porta do servidor local
PRF_HOST=127.0.0.1
PRF_PORT=5000

# Modo debug (1 = liga recarregamento automatico; use apenas em desenvolvimento)
PRF_DEBUG=0
